Bootstrap: docker
From: python:3.11-slim

%post
    pip install --no-cache-dir \
        numpy==2.2.6 scipy==1.15.3 pandas==2.2.3 \
        scikit-learn==1.7.2 pyarrow==17.0.0 matplotlib==3.9.2
    mkdir -p /srv/obfuscope

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec python3 "$@"

%labels
    Author  ObfuScope
    Version 1.0.0
