universe                = container
container_image         = osdf:///ospool/ap40/data/$ENV(USER)/obfuscope.sif
executable              = merge.sh
transfer_input_files    = obfuscope_src.tar.gz, data/shards/
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = features.csv
# Relative to the htc/ submit directory (-> htc/data/features.csv); consumed
# from that same path by experiment.sub's transfer_input_files.
transfer_output_remaps  = "features.csv = data/features.csv"
request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB
+JobDurationCategory    = "Medium"
output                  = logs/merge.out
error                   = logs/merge.err
log                     = logs/merge.log
queue
