universe                = container
container_image         = osdf:///ospool/ap40/data/$ENV(USER)/obfuscope.sif
executable              = aggregate.sh
transfer_input_files    = obfuscope_src.tar.gz, results/cells.tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = outputs.tar.gz
request_cpus            = 1
request_memory          = 2GB
request_disk            = 2GB
+JobDurationCategory    = "Medium"
output                  = logs/agg.out
error                   = logs/agg.err
log                     = logs/agg.log
queue
